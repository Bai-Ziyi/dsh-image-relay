{
  "name": "dsh-image-relay",
  "version": "0.2.0",
  "description": "Generate images from a text prompt through an OpenAI-compatible relay and attach them to the conversation.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "image-generation",
    "openai",
    "relay"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bai-Ziyi/dsh-image-relay.git"
  },
  "homepage": "https://github.com/Bai-Ziyi/dsh-image-relay",
  "bugs": {
    "url": "https://github.com/Bai-Ziyi/dsh-image-relay/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
